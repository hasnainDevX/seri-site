# Copy to .env.local, enter your EmailJS values, then restart Next.js.
# These are public browser configuration values. Do not add a private key.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TRAINING_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=

# Canonical production origin; previews on Vercel are noindexed automatically.
SITE_URL=https://seribeauty.ca
# Set true on non-Vercel public staging deployments.
SITE_NOINDEX=false
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
